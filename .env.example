# ─────────────────────────────────────────────────────────────
# EV Ops Copilot — environment
# Copy to .env and fill in GROQ_API_KEY. Everything else has a
# working default. Nothing here needs a paid account.
# ─────────────────────────────────────────────────────────────

# ── THE ONLY THING YOU MUST SET ──────────────────────────────
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model tiers. Cheap tier runs router + reflect (classification,
# high call volume). Strong tier runs plan + synthesize.
# Free-tier daily budgets differ a lot between these two, which is
# exactly why the tiering exists.
LLM_MODEL_CHEAP=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Embeddings + reranking (local, no API key, no cost) ──────
# Downloaded once from HuggingFace on first run, then cached.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base
HF_HOME=/app/.cache/huggingface

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=opscopilot
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=opscopilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Read-only role the agent's SQL tool uses. Never the owner role.
DB_READONLY_USER=copilot_readonly
DB_READONLY_PASSWORD=change_me_locally_too

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_READONLY=postgresql+psycopg://${DB_READONLY_USER}:${DB_READONLY_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── MCP ──────────────────────────────────────────────────────
# stdio = server spawned as a subprocess (simplest, default)
# http  = server runs standalone, agent connects over HTTP
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=8765

# ── Observability (optional — system runs fine without it) ───
# Free self-hosted or cloud tier: https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
TRACING_ENABLED=true

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed to call the API (comma-separated). Explicit only,
# never "*" — list your UI's address here when you deploy one.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
