# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Model cache (large — re-downloaded on demand)
.cache/
models/
*.onnx
*.safetensors

# Data
data/raw/
data/processed/
# Local collector inputs; may contain real brand names or URLs.
data/sources.yaml
data/anonymize.local.yaml
*.db
*.sqlite3

# Eval output
evaluation_runs/
*.eval.json

# Editors / OS
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# UI
ui/node_modules/
ui/dist/
# Satoshi is fetched at build time: its licence forbids redistributing the
# files from a public repository (see ui/scripts/fetch-fonts.mjs).
ui/public/fonts/
# Playwright output
ui/test-results/
ui/playwright-report/

# Scratch request bodies for curl
question.json
